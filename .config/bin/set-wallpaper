#!/usr/bin/bash

set_wallpaper() {
    if [[ $DESKTOP_ENVIRONMENT = "hyprland" ]]; then
        hyprpaper
    elif [[ $DESKTOP_ENVIRONMENT = "bspwm" ]]; then
        feh --no-fehbg --bg-fill "$XDG_CONFIG_HOME"/feh/wallpaper
    fi

    exit 0
}

update_wallpaper() {
    if [[ $DESKTOP_ENVIRONMENT = "hyprland" ]]; then
        hyprctl hyprpaper preload "$wallpaper"
        hyprctl hyprpaper wallpaper ",$wallpaper"
    elif [[ $DESKTOP_ENVIRONMENT = "bspwm" ]]; then
        rm -f "$XDG_CONFIG_HOME"/feh/wallpaper/*
        cp "$wallpaper" "$XDG_CONFIG_HOME"/feh/wallpaper/
        feh --no-fehbg --bg-fill "$XDG_CONFIG_HOME"/feh/wallpaper
    fi

    exit 0
}

if [[ $1 == "--update" || $1 == "-u" ]]; then
    shift
    wallpaper="$WALLPAPERS/$1"

    if [[ ! -f $wallpaper ]]; then
        echo "Wallpaper does not exist. Wallpapers:"
        echo ""
        wallpapers=$(ls "$WALLPAPERS")
        printf "%s\n" "${wallpapers[@]}"
        exit 1
    fi

    update_wallpaper "$wallpaper"
else
    set_wallpaper
fi
